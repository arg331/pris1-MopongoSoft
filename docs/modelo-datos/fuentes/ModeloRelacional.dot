ont></td><td align="left" port="plazas_e"><font color="#666666" point-size="11">SMALLINT</font></td></tr><tr><td align="left" port="dias_horario_w"><font color="#1F5FA8" point-size="11"> </font></td><td align="left"><font color="#000000" point-size="12">dias_horario</font></td><td align="left" port="dias_horario_e"><font color="#666666" point-size="11">VARCHAR(100) ?</font></td></tr></table>>];
  menor [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" color="#1A8A87" bgcolor="#E3F4F2"><tr><td colspan="3" bgcolor="#1A8A87"><font color="white" point-size="13"><b>menor</b></font></td></tr><tr><td align="left" port="id_menor_w"><font color="#1F5FA8" point-size="11">PK</font></td><td align="left"><font color="#000000" point-size="12"><b><u>id_menor</u></b></font></td><td align="left" port="id_menor_e"><font color="#666666" point-size="11">INTEGER</font></td></tr><tr><td align="left" port="id_tutor_w"><font color="#1F5FA8" point-size="11">FK</font></td><td align="left"><font color="#000000" point-size="12"><i>id_tutor</i></font></td><td align="left" port="id_tutor_e"><font color="#666666" point-size="11">INTEGER</font></td></tr><tr><td align="left" port="nombre_w"><font color="#1F5FA8" point-size="11"> </font></td><td align="left"><font color="#000000" point-size="12">nombre</font></td><td align="left" port="nombre_e"><font color="#666666" point-size="11">VARCHAR(60)</font></td></tr><tr><td align="left" port="apellidos_w"><font color="#1F5FA8" point-size="11"> </font></td><td align="left"><font color="#000000" point-size="12">apellidos</font></td><td align="left" port="apellidos_e"><font color="#666666" point-size="11">VARCHAR(100)</font></td></tr><tr><td align="left" port="fecha_nacimiento_w"><font color="#1F5FA8" point-size="11"> </font></td><td align="left"><font color="#000000" point-size="12">fecha_nacimiento</font></td><td align="left" port="fecha_nacimiento_e"><font color="#666666" point-size="11">DATE</font></td></tr></table>>];
  inscripcion_escuela [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" color="#1A8A87" bgcolor="#E3F4F2"><tr><td colspan="3" bgcolor="#1A8A87"><font color="white" point-size="13"><b>inscripcion_escuela</b></font></td></tr><tr><td align="left" port="id_escuela_w"><font color="#1F5FA8" point-size="11">PK FK</font></td><td align="left"><font color="#000000" point-size="12"><b><u>id_escuela</u></b></font></td><td align="left" port="id_escuela_e"><font color="#666666" point-size="11">INTEGER</font></td></tr><tr><td align="left" port="id_menor_w"><font color="#1F5FA8" point-size="11">PK FK</font></td><td align="left"><font color="#000000" point-size="12"><b><u>id_menor</u></b></font></td><td align="left" port="id_menor_e"><font color="#666666" point-size="11">INTEGER</font></td></tr><tr><td align="left" port="fecha_inscripcion_w"><font color="#1F5FA8" point-size="11"> </font></td><td align="left"><font color="#000000" point-size="12">fecha_inscripcion</font></td><td align="left" port="fecha_inscripcion_e"><font color="#666666" point-size="11">TIMESTAMP</font></td></tr><tr><td align="left" port="estado_w"><font color="#1F5FA8" point-size="11"> </font></td><td align="left"><font color="#000000" point-size="12">estado</font></td><td align="left" port="estado_e"><font color="#666666" point-size="11">VARCHAR(10)</font></td></tr></table>>];
