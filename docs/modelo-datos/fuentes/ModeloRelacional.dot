  { rank=same; rol; entidad_convenio; tipo_instalacion; }
  { rank=same; usuario; instalacion; }
  { rank=same; evento; menor; reserva; escuela; horario_instalacion; }
  { rank=same; inscripcion_evento; bloqueo; sancion; inscripcion_escuela; }
  rol:id_rol_e -> usuario:id_rol_w [dir=both, arrowhead=crow, arrowtail=teetee];
  entidad_convenio:id_entidad_e -> usuario:id_entidad_w [dir=both, arrowhead=crow, arrowtail=teeodot, style=dashed, color="#D9822B", penwidth=2];
  tipo_instalacion:id_tipo_e -> instalacion:id_tipo_w [dir=both, arrowhead=crow, arrowtail=teetee];
  instalacion:id_instalacion_e -> horario_instalacion:id_instalacion_w [dir=both, arrowhead=crow, arrowtail=teetee];
  usuario:id_usuario_e -> reserva:id_usuario_w [dir=both, arrowhead=crow, arrowtail=teetee];
  instalacion:id_instalacion_e -> reserva:id_instalacion_w [dir=both, arrowhead=crow, arrowtail=teetee];
  entidad_convenio:id_entidad_e -> reserva:id_entidad_w [dir=both, arrowhead=crow, arrowtail=teeodot, style=dashed];
  usuario:id_usuario_e -> reserva:id_autorizador_w [dir=both, arrowhead=crow, arrowtail=teeodot, style=dashed];
  instalacion:id_instalacion_e -> bloqueo:id_instalacion_w [dir=both, arrowhead=crow, arrowtail=teetee];
  usuario:id_usuario_e -> bloqueo:id_creador_w [dir=both, arrowhead=crow, arrowtail=teetee];
  evento:id_evento_e -> bloqueo:id_evento_w [dir=both, arrowhead=crow, arrowtail=teeodot, style=dashed];
  usuario:id_usuario_e -> evento:id_organizador_w [dir=both, arrowhead=crow, arrowtail=teetee];
  evento:id_evento_e -> inscripcion_evento:id_evento_w [dir=both, arrowhead=crow, arrowtail=teetee];
  usuario:id_usuario_e -> inscripcion_evento:id_usuario_w [dir=both, arrowhead=crow, arrowtail=teetee];
  instalacion:id_instalacion_e -> escuela:id_instalacion_w [dir=both, arrowhead=crow, arrowtail=teetee];
  usuario:id_usuario_e -> menor:id_tutor_w [dir=both, arrowhead=crow, arrowtail=teetee];
  escuela:id_escuela_e -> inscripcion_escuela:id_escuela_w [dir=both, arrowhead=crow, arrowtail=teetee];
  menor:id_menor_e -> inscripcion_escuela:id_menor_w [dir=both, arrowhead=crow, arrowtail=teetee];
  usuario:id_usuario_e -> sancion:id_usuario_w [dir=both, arrowhead=crow, arrowtail=teetee];
  reserva:id_reserva_e -> sancion:id_reserva_w [dir=both, arrowhead=crow, arrowtail=teeodot, style=dashed];
}