  instalacion:id_instalacion_r:e -> escuela:id_instalacion:w [style=solid, arrowhead=crow, arrowtail=teetee];
  usuario:id_usuario_r:e -> menor:id_tutor:w [style=solid, arrowhead=crow, arrowtail=teetee];
  escuela:id_escuela_r:e -> inscripcion_escuela:id_escuela:w [style=solid, arrowhead=crow, arrowtail=teetee];
  menor:id_menor_r:e -> inscripcion_escuela:id_menor:w [style=solid, arrowhead=crow, arrowtail=teetee];
  usuario:id_usuario_r:e -> sancion:id_usuario:w [style=solid, arrowhead=crow, arrowtail=teetee];
  reserva:id_reserva_r:e -> sancion:id_reserva:w [style=dashed, arrowhead=crow, arrowtail=teeodot];
}