  inscripcion_escuela [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#E3F4F3" COLOR="#1B8A8F"><TR><TD COLSPAN="3" BGCOLOR="#1B8A8F"><FONT COLOR="white"><B>inscripcion_escuela</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_escuela"><FONT COLOR="#0B3A6E">PK FK</FONT></TD><TD ALIGN="LEFT"><B><U>id_escuela</U></B></TD><TD ALIGN="LEFT" PORT="id_escuela_r"><FONT COLOR="#5B6573">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_menor"><FONT COLOR="#0B3A6E">PK FK</FONT></TD><TD ALIGN="LEFT"><B><U>id_menor</U></B></TD><TD ALIGN="LEFT" PORT="id_menor_r"><FONT COLOR="#5B6573">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="fecha_inscripcion"><FONT COLOR="#0B3A6E"> </FONT></TD><TD ALIGN="LEFT">fecha_inscripcion</TD><TD ALIGN="LEFT" PORT="fecha_inscripcion_r"><FONT COLOR="#5B6573">TIMESTAMP</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="estado"><FONT COLOR="#0B3A6E"> </FONT></TD><TD ALIGN="LEFT">estado</TD><TD ALIGN="LEFT" PORT="estado_r"><FONT COLOR="#5B6573">VARCHAR(10)</FONT></TD></TR></TABLE>>];
  sancion [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#E3F4F3" COLOR="#1B8A8F"><TR><TD COLSPAN="3" BGCOLOR="#1B8A8F"><FONT COLOR="white"><B>sancion</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_sancion"><FONT COLOR="#0B3A6E">PK</FONT></TD><TD ALIGN="LEFT"><B><U>id_sancion</U></B></TD><TD ALIGN="LEFT" PORT="id_sancion_r"><FONT COLOR="#5B6573">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_usuario"><FONT COLOR="#0B3A6E">FK</FONT></TD><TD ALIGN="LEFT"><I>id_usuario</I></TD><TD ALIGN="LEFT" PORT="id_usuario_r"><FONT COLOR="#5B6573">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_reserva"><FONT COLOR="#0B3A6E">FK</FONT></TD><TD ALIGN="LEFT"><I>id_reserva</I></TD><TD ALIGN="LEFT" PORT="id_reserva_r"><FONT COLOR="#5B6573">INTEGER ?</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="motivo"><FONT COLOR="#0B3A6E"> </FONT></TD><TD ALIGN="LEFT">motivo</TD><TD ALIGN="LEFT" PORT="motivo_r"><FONT COLOR="#5B6573">VARCHAR(255)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="fecha_inicio"><FONT COLOR="#0B3A6E"> </FONT></TD><TD ALIGN="LEFT">fecha_inicio</TD><TD ALIGN="LEFT" PORT="fecha_inicio_r"><FONT COLOR="#5B6573">DATE</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="fecha_fin"><FONT COLOR="#0B3A6E"> </FONT></TD><TD ALIGN="LEFT">fecha_fin</TD><TD ALIGN="LEFT" PORT="fecha_fin_r"><FONT COLOR="#5B6573">DATE</FONT></TD></TR></TABLE>>];
